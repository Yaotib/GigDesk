# Copy to .env.local and fill in. Never commit real values: this repo is public.

# Supabase (public: safe in the browser, still protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role: SERVER/SCRIPTS ONLY, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# Groq: server only
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo

# live | mock  (tests and E2E always use mock)
AI_MODE=mock

# Comma-separated team emails allowed to sign in
ALLOWED_EMAILS=

APP_TIMEZONE=Africa/Accra
